Step 2: Script to audit current IP connections
Script name
audit_ip_connections.sh

Script content (WRITE THIS ON PAPER)
#!/bin/bash

# Blacklisted IPs
BLACKLIST="1.1.1.1 98.89.89.89 2.2.2.2"

# Get current active IP connections
ACTIVE_IPS=$(netstat -ntu | awk '{print $5}' | cut -d: -f1 | sort | uniq)

# Check for matches
for ip in $ACTIVE_IPS
do
    for bad_ip in $BLACKLIST
    do
        if [ "$ip" = "$bad_ip" ]; then
            echo "Blacklisted IP detected: $ip"
        fi
    done
done

